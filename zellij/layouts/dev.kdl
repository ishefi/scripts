// Dev layout: Main editor + terminal + sidebar
// Usage: zellij --layout dev

layout {
    // zellaude
    pane size=1 borderless=true {
        plugin location="https://github.com/ishefi/zellaude/releases/latest/download/zellaude.wasm"
    }
    // main area + terminal below
    pane split_direction="horizontal" {
        // Main pane
        pane size="70%" {
            name "main"
        }
        // Terminal and weather pane
        pane split_direction="vertical"{
            pane command="zsh" {
                name "terminal"
                args "-c" "fortune -s | cowsay; exec zsh"
            }
            pane size="35" {
                name "wttr"
                command "wttr-loop"
            }
        }
    }
    // Floating side-pane for editor
    floating_panes {
        pane {
            y "100%"
            x 0
            name "wttr"
            height "20"
            width "70"
            command "wttr-loop"
        }
        pane {
            y 1
            x "100%"
            name "editor"
            height "100%"
            width 95
        }
    }
    pane size=1 borderless=true {
        plugin location="zellij:status-bar"
    }
}
