# run:
# ```
# ln -s `realpath .myrc` ~/.myrc
# ```
# then add the following line to `~/.basrc` or `~/.bash_profile` or whatever:
# `source ~/.myrc`
# you can do it by running the following command:
# ```
# echo "source ~/.myrc" >> ~/.zshrc
# ```
# eval `keychain --quiet --eval id_rsa`
export LSCOLORS=ExGxcxDxCxegedabagaced
alias ls='ls -G'
alias ll='ls -alF'
alias chrome='open -a "Google Chrome" "$@"'
alias please='sudo $(fc -ln -1)'
alias del-pyc='find . -name "*.pyc" -exec rm -f {} \;'
alias reloadrc='source ~/.myrc'
alias venvstart='source venv/bin/activate'
export EDITOR=nvim
export XDG_CONFIG_HOME="$HOME/.config"
bindkey "^R" history-incremental-search-backward
autoload -Uz compinit && compinit
if [ -f ~/.workrc ]
then
  source ~/.workrc
fi

if command -v zellij &> /dev/null
then
  if [[ ! "$ZELLIJ" ]]
  then
#     zellij -l welcome
  fi
fi

# Switch to vi mode
set -o vi
bindkey -v

# Use beam cursor in insert mode, block in normal mode
function zle-keymap-select {
  if [[ ${KEYMAP} == vicmd ]] || [[ $1 = 'block' ]]; then
    echo -ne '\e[1 q'
  elif [[ ${KEYMAP} == main ]] || [[ ${KEYMAP} == viins ]] || [[ $1
 = 'beam' ]]; then
    echo -ne '\e[5 q'
  fi
}
zle -N zle-keymap-select

# purge zellaude plugin cache and reloade
zellaude-upgrade() {
  local cache=~/Library/Caches/org.Zellij-Contributors.Zellij
  local url="https://github.com/ishefi/zellaude/releases/latest/download/zellaude.wasm"

  # Find the existing cached wasm blob (keyed by URL hash)
  local target
  for f in $cache/*(.N); do
    if file "$f" 2>/dev/null | grep -qi webassembly; then
      target=$f
      break
    fi
  done

  if [[ -z $target ]]; then
    echo "no cached zellaude wasm found — start zellij first so it populates the cache"
    return 1
  fi

  curl -fsSL "$url" -o "$target" || { echo "download failed"; return 1; }
  rm -rf $cache/0.43.1  # flush wasmtime's AOT cache so it recompiles
  zellij action start-or-reload-plugin "$url"
}

# Ensure beam cursor when starting a new prompt
echo -ne '\e[5 q'
